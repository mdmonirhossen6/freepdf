# Required: Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Recommended: Gemini API key from https://aistudio.google.com/apikey
# (If left blank, the bot automatically falls back to local Bangla/English search)
GEMINI_API_KEY=

# Optional: Gemini model name (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Source Telegram channel (@username or numeric -100... chat ID)
CHANNEL_ID=@hscfreepdf
CHANNEL_USERNAME=hscfreepdf

# Delivery mode:
#   link = (Default) Works WITHOUT channel admin rights! Sends AI card + 1-tap buttons to the exact channel post
#   copy = Copies actual PDF files from channel (requires bot to be Admin in CHANNEL_ID)
DELIVERY_MODE=link

# Realtime auto-indexing of new channel posts (true/false).
# Keep false to use your CSV index snapshot only.
AUTO_INDEX=false

# Auto-forward user DM text messages sent to the bot into your Discussion Group
# Leave DISCUSSION_GROUP_ID blank to auto-detect from CHANNEL_ID's linked discussion group!
AUTO_FORWARD_DM=true
DISCUSSION_GROUP_ID=
# Set true to also post the bot's PDF result card under the forwarded message in the group
FORWARD_DM_BOT_REPLY=true

# Optional: Comma-separated Telegram group IDs allowed to use the bot
# Leave blank to allow any group where you add the bot
ALLOWED_GROUP_IDS=

# Ultra Admin user ID(s) with full control (owner: @md_monir01 = 6885443469)
ULTRA_ADMIN_IDS=6885443469

# Optional: Comma-separated Telegram user IDs for regular Admins (can send messages & promos)
ADMIN_USER_IDS=

# Optional: Default auto-promo footer attached to search results (survives redeploys)
DEFAULT_PROMO_TEXT=
DEFAULT_PROMO_BTN_TEXT=
DEFAULT_PROMO_BTN_URL=

# Optional: Private channel/chat ID to auto-upload index.json backups after new posts
BACKUP_CHAT_ID=

# Optional: Custom path for index.json (useful for Railway/Render persistent volumes, e.g. /data/index.json)
INDEX_PATH=bot/data/index.json

# Optional: Anti-spam per-user cooldown in seconds (default: 5)
COOLDOWN_SECONDS=5

# Optional: Number of similar PDF buttons shown under each result (1-8, default: 5)
MAX_SIMILAR_BUTTONS=5

# Optional: Auto-delete bot replies in groups after N seconds (0 = keep forever)
AUTO_DELETE_SECONDS=0

# Optional: HTTP healthcheck port for Railway / Render / Koyeb (default: 8080)
PORT=8080
