{
  "name": "hscfreepdf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Free Pdf — static, serverless searchable HSC & admission resource library for the Telegram channel @hscfreepdf.",
  "scripts": {
    "data": "node scripts/generate-data.ts",
    "data:import": "node scripts/import-csv.ts",
    "dev": "npm run data && next dev",
    "build": "next build",
    "prebuild": "npm run data",
    "typecheck": "tsc --noEmit",
    "preview": "npx --yes serve out -l 4321",
    "bot:seed": "node bot/seed.ts",
    "bot:dev": "node --watch bot/index.ts",
    "bot:start": "node bot/index.ts",
    "bot:test": "node bot/test-search.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^18.0.10",
    "grammy": "^1.46.0",
    "gsap": "^3.15.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
